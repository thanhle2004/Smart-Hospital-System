generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// AUTH ENUM
//////////////////////////////////////////////////

enum Role {
  USER
  ADMIN
}

//////////////////////////////////////////////////
// SCHEDULING ENUMS
//////////////////////////////////////////////////

enum VisitStatusEnum {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitRoomStatusEnum {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

//////////////////////////////////////////////////
// AUTH MODELS
//////////////////////////////////////////////////

model User {
  id           String  @id @default(uuid()) @db.Char(36)
  email        String  @unique
  passwordHash String
  role         Role    @default(USER)
  isActive     Boolean @default(true)

  profile       UserProfile?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserProfile {
  id        String  @id @default(uuid()) @db.Char(36)
  userId    String  @unique @db.Char(36)
  fullName  String?
  avatarUrl String?
  bio       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////
// PATIENT TYPE - Dùng để phân biệt các loại bệnh nhân, hỗ trợ cho priority rule
//////////////////////////////////////////////////

model PatientType {
  id           Int     @id @default(autoincrement())
  code         String  @unique // NORMAL, VIP...
  name         String
  description  String?
  basePriority Int?
  isActive     Boolean @default(true)

  patients      Patient[]
  priorityRules PriorityRule[]
}

//////////////////////////////////////////////////
// PATIENT - Quản lý bệnh nhân
//////////////////////////////////////////////////

model Patient {
  id    Int     @id @default(autoincrement())
  name  String
  email String? @unique
  phone String  @unique

  patientTypeId Int
  patientType   PatientType @relation(fields: [patientTypeId], references: [id])

  createdAt DateTime @default(now())

  visits Visit[]
}

//////////////////////////////////////////////////
// PRIORITY RULE - Dùng để quy định mức độ ưu tiên của một người khi đến khám
//////////////////////////////////////////////////

model PriorityRule {
  id Int @id @default(autoincrement())

  ruleName String

  minAge Int?
  maxAge Int?

  patientTypeId Int?
  patientType   PatientType? @relation(fields: [patientTypeId], references: [id], onDelete: SetNull)

  isEmergency Boolean @default(false)

  priorityValue Int
  applyOrder    Int     @default(0)
  isActive      Boolean @default(true)

  visits Visit[]
}

//////////////////////////////////////////////////
// FLOW - Quản lý các quy trình khám (VD: khám tổng quát, xét nghiệm,...)
//////////////////////////////////////////////////

model Flow {
  id   Int    @id @default(autoincrement())
  name String

  flowRooms FlowRoom[]
  visits    Visit[]

  dependencies FlowRoomDependency[]
}

//////////////////////////////////////////////////
// ROOM - Quản lý các phòng khám vật lý
//////////////////////////////////////////////////

model Room {
  id             Int    @id @default(autoincrement())
  name           String
  roomNumber     Int
  capacity       Int
  roomTypeId     Int
  avgProcessTime Int

  visitRooms VisitRoom[]

  roomType RoomType @relation(fields: [roomTypeId], references: [id])
}

//////////////////////////////////////////////////
// ROOM TYPE - Loại phòng khám
//////////////////////////////////////////////////

model RoomType {
  id Int @id @default(autoincrement())

  name        String
  description String?

  avgProcessTime  Int
  defaultCapacity Int

  rooms     Room[]
  flowRooms FlowRoom[]

  dependencies           FlowRoomDependency[] @relation("DependencyMain")
  requiredByDependencies FlowRoomDependency[] @relation("DependencyRequired")
}

//////////////////////////////////////////////////
// FLOW ROOM - Các loại phòng khám trong một quy trình khám 
//////////////////////////////////////////////////

model FlowRoom {
  id           Int @id @default(autoincrement())
  flowId       Int
  roomTypeId   Int
  defaultOrder Int

  flow     Flow     @relation(fields: [flowId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([flowId, roomTypeId])
}

//////////////////////////////////////////////////
// FLOW ROOM DEPENDENCY - Quy định phòng nào cần được khám trước phòng nào trong một quy trình khám
//////////////////////////////////////////////////

model FlowRoomDependency {
  flowId Int

  roomTypeId         Int
  requiredRoomTypeId Int

  flow Flow @relation(fields: [flowId], references: [id])

  roomType         RoomType @relation("DependencyMain", fields: [roomTypeId], references: [id])
  requiredRoomType RoomType @relation("DependencyRequired", fields: [requiredRoomTypeId], references: [id])

  @@id([flowId, roomTypeId, requiredRoomTypeId])
}

//////////////////////////////////////////////////
// VISIT - Đại diên cho lần đi khám đó của bệnh nhân
//////////////////////////////////////////////////

model Visit {
  id        Int @id @default(autoincrement())
  patientId Int
  flowId    Int

  checkInTime DateTime @default(now())

  appliedPriorityRuleId Int?
  status                VisitStatusEnum

  patient             Patient       @relation(fields: [patientId], references: [id])
  flow                Flow          @relation(fields: [flowId], references: [id])
  appliedPriorityRule PriorityRule? @relation(fields: [appliedPriorityRuleId], references: [id], onDelete: SetNull)

  visitRooms   VisitRoom[]
  centralQueue CentralQueue?
}

//////////////////////////////////////////////////
// VISIT ROOM - Các phòng bệnh nhân phải khám trong lần đi khám đó, dựa theo flow mà bệnh nhân chọn, có thể thêm/bớt theo bác sĩ
//////////////////////////////////////////////////

model VisitRoom {
  id      Int @id @default(autoincrement())
  visitId Int
  roomId  Int

  priority Int?
  status   VisitRoomStatusEnum

  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id])
  room  Room  @relation(fields: [roomId], references: [id])

  roomQueues RoomQueue[]

  @@unique([visitId, roomId])
}

//////////////////////////////////////////////////
// CENTRAL QUEUE - 
//////////////////////////////////////////////////

model CentralQueue {
  id      BigInt @id @default(autoincrement())
  visitId Int    @unique

  calculatedPriority Int?
  manualPriority     Int?

  queueTime      DateTime @default(now())
  globalSequence BigInt

  visit Visit @relation(fields: [visitId], references: [id])
}

//////////////////////////////////////////////////
// ROOM QUEUE
//////////////////////////////////////////////////

model RoomQueue {
  id          BigInt   @id @default(autoincrement())
  visitRoomId Int
  enqueueTime DateTime @default(now())

  visitRoom VisitRoom @relation(fields: [visitRoomId], references: [id])
}
