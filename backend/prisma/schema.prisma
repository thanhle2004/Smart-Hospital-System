generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// AUTH ENUM
//////////////////////////////////////////////////

enum Role {
  ADMIN
  DOCTOR
}

//////////////////////////////////////////////////
// SCHEDULING ENUMS
//////////////////////////////////////////////////

enum VisitStatusEnum {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitRoomStatusEnum {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

//////////////////////////////////////////////////
// AUTH MODELS
//////////////////////////////////////////////////

model User {
  id           String  @id @default(uuid()) @db.Char(36)
  email        String  @unique
  passwordHash String
  role         Role    @default(DOCTOR)
  isActive     Boolean @default(true)

  profile       UserProfile?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastLoginAt DateTime?
  roomAssignments RoomDoctor[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserProfile {
  id        String  @id @default(uuid()) @db.Char(36)
  userId    String  @unique @db.Char(36)
  fullName  String?
  avatarUrl String?
  bio       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////
// PATIENT TYPE
//////////////////////////////////////////////////

model PatientType {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  description  String?
  basePriority Int?
  isActive     Boolean @default(true)

  patients      Patient[]
  priorityRules PriorityRule[]
}

//////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////

model Patient {
  id    String  @id @default(uuid()) @db.Char(36)
  name  String
  email String? @unique
  phone String  @unique
  yearOfBirth Int

  patientTypeId Int
  patientType   PatientType @relation(fields: [patientTypeId], references: [id])

  createdAt DateTime @default(now())

  visits Visit[]
}

//////////////////////////////////////////////////
// PRIORITY RULE
//////////////////////////////////////////////////

model PriorityRule {
  id Int @id @default(autoincrement())

  ruleName String

  minAge Int?
  maxAge Int?

  patientTypeId Int?
  patientType   PatientType? @relation(fields: [patientTypeId], references: [id], onDelete: SetNull)

  isEmergency Boolean @default(false)

  priorityValue Int
  applyOrder    Int     @default(0)
  isActive      Boolean @default(true)

  visits Visit[]
}

//////////////////////////////////////////////////
// FLOW TEMPLATE
//////////////////////////////////////////////////

model Flow {
  id   Int    @id @default(autoincrement())
  name String

  flowRooms FlowRoom[]
  visits    Visit[]

  dependencies FlowRoomDependency[]
}

model FlowRoom {
  id           Int @id @default(autoincrement())
  flowId       Int
  roomTypeId   Int
  defaultOrder Int

  flow     Flow     @relation(fields: [flowId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([flowId, roomTypeId])
}

model FlowRoomDependency {
  flowId Int

  roomTypeId         Int
  requiredRoomTypeId Int

  flow Flow @relation(fields: [flowId], references: [id])

  roomType         RoomType @relation("DependencyMain", fields: [roomTypeId], references: [id])
  requiredRoomType RoomType @relation("DependencyRequired", fields: [requiredRoomTypeId], references: [id])

  @@id([flowId, roomTypeId, requiredRoomTypeId])
}

//////////////////////////////////////////////////
// ROOM
//////////////////////////////////////////////////

model Room {
  id             Int    @id @default(autoincrement())
  name           String
  roomNumber     Int
  capacity       Int
  roomTypeId     Int?
  avgProcessTime Int
  isActive       Boolean  @default(true)

  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  visitRooms VisitRoom[]
  roomAssignments RoomDoctor[]
}

model RoomType {
  id Int @id @default(autoincrement())

  name        String
  description String?

  avgProcessTime  Int
  defaultCapacity Int

  rooms     Room[]
  flowRooms FlowRoom[]
  visitRooms VisitRoom[]

  dependencies           FlowRoomDependency[] @relation("DependencyMain")
  requiredByDependencies FlowRoomDependency[] @relation("DependencyRequired")

  visitFlows VisitFlow[]
}

model RoomDoctor {
  id        Int      @id @default(autoincrement())
  roomId    Int
  doctorId  String   @db.Char(36)
  
  // Shift start and end time
  startTime DateTime @default(now())
  endTime   DateTime? // If null, the doctor is still on duty there

  isActive  Boolean  @default(true)

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([roomId, isActive])
  @@index([doctorId, isActive])
}

//////////////////////////////////////////////////
// VISIT
//////////////////////////////////////////////////

model Visit {
  id        String @id @default(uuid()) @db.Char(36)
  patientId String @db.Char(36)
  flowId    Int

  checkInTime DateTime @default(now())

  appliedPriorityRuleId Int?
  status                VisitStatusEnum

  patient Patient @relation(fields: [patientId], references: [id])
  flow    Flow    @relation(fields: [flowId], references: [id])

  appliedPriorityRule PriorityRule? @relation(fields: [appliedPriorityRuleId], references: [id], onDelete: SetNull)

  visitRooms   VisitRoom[]
  centralQueue CentralQueue?

  visitFlows VisitFlow[]
}

//////////////////////////////////////////////////
// VISIT FLOW (runtime workflow)
//////////////////////////////////////////////////

model VisitFlow {
  id         Int @id @default(autoincrement())
  visitId    String @db.Char(36)
  roomTypeId Int

  orderIndex Int

  isSkipped       Boolean @default(false)
  isAddedManually Boolean @default(false)

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  dependencies       VisitFlowDependency[] @relation("VF_Main")
  requiredBy         VisitFlowDependency[] @relation("VF_Required")

  @@unique([visitId, roomTypeId])
}

model VisitFlowDependency {
  visitFlowId         Int
  requiredVisitFlowId Int

  visitFlow         VisitFlow @relation("VF_Main", fields: [visitFlowId], references: [id], onDelete: Cascade)
  requiredVisitFlow VisitFlow @relation("VF_Required", fields: [requiredVisitFlowId], references: [id], onDelete: Cascade)

  @@id([visitFlowId, requiredVisitFlowId])
}

//////////////////////////////////////////////////
// VISIT ROOM (execution)
//////////////////////////////////////////////////

model VisitRoom {
  id      Int @id @default(autoincrement())
  visitId String @db.Char(36)

  roomId     Int?
  roomTypeId Int?

  priority Int?
  status   VisitRoomStatusEnum

  createdAt   DateTime  @default(now()) // Timestamp when this record was created (queued in room)
  startTime   DateTime? // Timestamp when the doctor clicked "Start visit"
  endTime     DateTime? // Timestamp when the doctor clicked "Complete"

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  room  Room? @relation(fields: [roomId], references: [id])
  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  roomQueues RoomQueue[]
}

//////////////////////////////////////////////////
// CENTRAL QUEUE
//////////////////////////////////////////////////

model CentralQueue {
  id      BigInt @id @default(autoincrement())
  visitId String @db.Char(36) @unique

  calculatedPriority Int?
  manualPriority     Int?

  queueTime      DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////
// ROOM QUEUE
//////////////////////////////////////////////////

model RoomQueue {
  id          BigInt   @id @default(autoincrement())
  visitRoomId Int
  enqueueTime DateTime @default(now())

  visitRoom VisitRoom @relation(fields: [visitRoomId], references: [id], onDelete: Cascade)
}